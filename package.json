{
  "name": "antigravity-remote",
  "version": "1.0.0",
  "description": "Antigravity Remote — Self-Hosted Mobile Companion & Gemini Profile Auto-Discovery Microserver for Brave iOS",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint:memory": "node scripts/lint-memory.mjs",
    "memory:export": "rm -rf ~/.npm/_npx/*/node_modules/antigravity-memory-bank 2>/dev/null; npx -y github:johnny-saigon/antigravity-memory-bank export",
    "memory:uninstall": "rm -rf ~/.npm/_npx/*/node_modules/antigravity-memory-bank 2>/dev/null; npx -y github:johnny-saigon/antigravity-memory-bank uninstall",
    "memory:sync": "node scripts/sync-memory-context.mjs",
    "memory:upgrade": "rm -rf ~/.npm/_npx/*/node_modules/antigravity-memory-bank 2>/dev/null; npx -y github:johnny-saigon/antigravity-memory-bank upgrade",
    "backlog": "node scripts/backlog.mjs",
    "backlog:list": "node scripts/backlog.mjs list",
    "backlog:add": "node scripts/backlog.mjs add",
    "backlog:start": "node scripts/backlog.mjs start",
    "backlog:done": "node scripts/backlog.mjs done",
    "backlog:render": "node scripts/backlog.mjs render",
    "backlog:serve": "node scripts/backlog.mjs serve",
    "backlog:attach": "node scripts/backlog.mjs attach",
    "backlog:unpack": "node scripts/backlog.mjs unpack"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.0",
    "@google/genai": "^2.30.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
